[Desktop Entry]
Name=Cosmic Applet HeadsetControl
Comment=Battery, chatmix and settings for USB headsets via headsetcontrol
Type=Application
Icon=audio-headset-symbolic
Exec=cosmic-applet-headsetcontrol
Terminal=false
StartupNotify=true
Categories=COSMIC
Keywords=COSMIC
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
X-CosmicShrinkable=true
X-OverflowPriority=10
MimeType=
