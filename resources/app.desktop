[Desktop Entry]
Name=Cosmic Applet Commands
Comment=Run configurable commands from the COSMIC panel
Type=Application
Icon=at.hoeggi.CosmicAppletCommands
Exec=cosmic-applet-commands %F
Terminal=false
StartupNotify=true
Categories=COSMIC
Keywords=COSMIC
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
MimeType=
