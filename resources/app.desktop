[Desktop Entry]
Name=Cosmic Applet Commands
Comment=Run configurable commands from the COSMIC panel
Type=Application
Icon=utilities-terminal-symbolic
Exec=cosmic-applet-commands
Terminal=false
StartupNotify=true
Categories=COSMIC
Keywords=COSMIC
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
X-CosmicShrinkable=true
X-OverflowPriority=10
MimeType=
